# Copia este archivo como .env y rellena los valores. El archivo .env NUNCA se sube a Git.

# Secreto compartido con el backend para firmar peticiones (HMAC). Mínimo 32 caracteres.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PANELVAULT_ENGINE_SECRET=

# Límites opcionales (estos son los valores por defecto).
PANELVAULT_MAX_UPLOAD_BYTES=15728640
PANELVAULT_MAX_PIXELS=40000000
PANELVAULT_SIGNATURE_TTL=300