# Copia este archivo como .env (o define las variables en tu sistema). El .env NUNCA se sube a Git.

# Secreto compartido con el backend para firmar peticiones (HMAC). Mínimo 32 caracteres.
# Debe ser EXACTAMENTE el mismo valor que PANELVAULT_ENGINE_SECRET del backend.
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
PANELVAULT_ENGINE_SECRET=

# Documentación interactiva (/docs, /redoc, /openapi.json). Apagada por defecto:
# en producción esta API solo la usa el backend. Ponla en true solo en local.
PANELVAULT_ENABLE_DOCS=false

# Límites opcionales (estos son los valores por defecto).
PANELVAULT_MAX_UPLOAD_BYTES=15728640
PANELVAULT_MAX_PIXELS=40000000
PANELVAULT_SIGNATURE_TTL=300
